{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sync-docs-on-stop.sh\"",
            "timeout": 30,
            "statusMessage": "Checking for documentation drift…"
          }
        ]
      }
    ]
  }
}
