dev.db
dev.db-journal
*.db
.env

# uploaded attachment blobs (kept outside public/)
.uploads/

# playwright mcp
.playwright-mcp/

# stray screenshots at the repo root (keep it clean; committed images live under docs/ or public/)
/*.png

# Claude Code: share settings/commands/hooks, keep personal overrides local
.claude/settings.local.json
